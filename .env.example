# --- Sanity Context MCP (server-side only; never expose to the browser) ---
# GROQ mode endpoint (dataset source). Example:
# https://api.sanity.io/vX/context/mcp/<orgId>/<mcpId>
SANITY_CONTEXT_MCP_URL=
# Optional second endpoint with ONLY Knowledge Base sources (dataset wins over KB on one endpoint)
SANITY_CONTEXT_KB_MCP_URL=
# Org-level token with Context Viewer (NOT a project token)
SANITY_ORGANIZATION_TOKEN=

# --- Sanity project (Studio + seed import) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# --- LLM (provide at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Prefer: openai | anthropic | google
LLM_PROVIDER=openai
# Optional model overrides
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_MODEL=gemini-2.5-flash
